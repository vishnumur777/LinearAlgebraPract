from numpy import linalg as lng


a = np.array([1,2,3,4,5])
b = np.array([6,7,8,9,10])


norm_a = lng.norm(a)


norm_a





dot_ab = np.dot(a,b)
norm_b = lng.norm(b)


scalar_projection = dot_ab / norm_b


scalar_projection





vector_projection = (np.dot(a,b) / np.dot(b,b))*b


vector_projection















































































































































